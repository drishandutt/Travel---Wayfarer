# Copy to .env and add your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# WAYFARER_MODEL=claude-opus-5-5
# WAYFARER_EFFORT_PLAN=medium     # low | medium | high | xhigh | max
# WAYFARER_EFFORT_INTAKE=low
# WAYFARER_EFFORT_HOTEL=low
# WAYFARER_BRAIN=mock             # force the offline planner
# WAYFARER_API_PORT=8787

# Shared expenses are kept in one SQLite file. In dev it's ./data/wayfarer.db.
# In production it needs a persistent volume: Railway's mount path is picked up
# automatically. With neither set, the money API stays off rather than lose data.
# WAYFARER_DB_PATH=/data/wayfarer.db
