# Copy to .env and add your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# WAYFARER_MODEL=claude-opus-5-5
# WAYFARER_EFFORT_PLAN=medium     # low | medium | high | xhigh | max
# WAYFARER_EFFORT_INTAKE=low
# WAYFARER_EFFORT_HOTEL=low
# WAYFARER_EFFORT_AGENT=low      # the trip chat assistant
# WAYFARER_BRAIN=mock             # force the offline planner
# WAYFARER_API_PORT=8787
# OPENAI_API_KEY=                # optional: without ANTHROPIC_API_KEY, OpenAI describes travellers' own places and finds their reels and TikToks
# WAYFARER_OPENAI_MODEL=gpt-6-astra
# YOUTUBE_API_KEY=               # optional: YouTube Data API for travellers' own places; without it, YouTube's search page is read

# Shared expenses live in Postgres. In dev, leave this unset: a Postgres runs inside the
# API process and keeps its files in ./data/pg. Don't point dev at the production database.
# In production it's Supabase's session pooler string (Connect > Session pooler), which
# works over IPv4. Without it there, the money API stays off rather than lose data.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_CA=          # optional: Supabase's CA certificate (PEM), to verify the server too

# One-time copy of the data kept in SQLite before the move. Set on production until it has
# run; it only ever runs into an empty database, and never changes the old file.
# WAYFARER_IMPORT_SQLITE=/data/wayfarer.db

# The photo vault keeps files in a private Supabase Storage bucket. Without these in
# production the vault is off; in dev, files go in ./data/vault instead.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # server only: never send it to the browser
# VAULT_BUCKET=vault
# VAULT_MAX_PHOTOS=2000           # per person
# VAULT_MAX_BYTES=3221225472      # per person, 3 GB
# VAULT_GEOCODE=off               # skip naming places with OpenStreetMap
