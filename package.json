{
  "name": "wayfarer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"npm:api\"",
    "web": "vite",
    "api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "start:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test \"server/**/*.test.ts\"",
    "phone": "concurrently -k -n web,api -c yellow,cyan \"vite --host\" \"npm:api\"",
    "start": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
